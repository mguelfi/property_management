# Copy to .env and adjust. All values are read by app/core/config.py.

# --- Database ---
PMS_DATABASE_URL=postgresql+psycopg://pms:pms@localhost:5432/pms

# --- HTTP server ---
PMS_HOST=0.0.0.0
PMS_PORT=8010

# --- Security ---
# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(48))"
PMS_SECRET_KEY=dev-insecure-change-me
PMS_ACCESS_TOKEN_TTL_MINUTES=480

# --- Property defaults (used by seed + as fallbacks) ---
PMS_DEFAULT_CURRENCY=AUD
PMS_DEFAULT_TIMEZONE=Australia/Brisbane

# --- Modules ---
# Comma-separated. Order does not matter; the registry resolves dependencies.
PMS_ENABLED_MODULES=auth,inventory,rates,availability,guests,reservations,frontdesk,billing,audit,webui

# --- Misc ---
PMS_DEBUG=true
